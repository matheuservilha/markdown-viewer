{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "dock", "peek", "note"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-watch",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "updater:default",
    "process:allow-restart"
  ]
}
