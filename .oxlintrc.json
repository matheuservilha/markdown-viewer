{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "src-tauri", "node_modules"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "typescript/no-explicit-any": "error",
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__APP_VERSION__", "__TAURI_INTERNALS__"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["scripts/**"],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
